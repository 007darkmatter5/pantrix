@inherits LayoutComponentBase
@inject IJSRuntime JS
@inject NavigationManager Navigation

<MudThemeProvider Theme="_theme.Theme" IsDarkMode="@(_theme.AlwaysDark || _darkMode)" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

@* Held back until the saved theme is known, so a dark-mode user doesn't see the light theme flash first. *@
@if (_themeLoaded)
{
<MudLayout>
    <MudAppBar Elevation="1">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
                       OnClick="@(() => _drawerOpen = !_drawerOpen)" aria-label="Toggle navigation" />
        <img src="@Assets["icon.svg"]" alt="" width="28" height="28" class="ml-2" />
        <MudText Typo="Typo.h6" Class="ml-2">Pantrix</MudText>
        <MudSpacer />
        <MudMenu Icon="@Icons.Material.Filled.Palette" Color="Color.Inherit" AriaLabel="Choose theme"
                 AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
            @foreach (var theme in AppThemes.All)
            {
                <MudMenuItem Icon="@(theme == _theme ? Icons.Material.Filled.RadioButtonChecked : Icons.Material.Filled.RadioButtonUnchecked)"
                             OnClick="@(() => SetThemeAsync(theme))">@theme.Name</MudMenuItem>
            }
        </MudMenu>
        @if (!_theme.AlwaysDark)
        {
            <MudIconButton Icon="@(_darkMode ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                           Color="Color.Inherit" OnClick="ToggleDarkModeAsync" aria-label="Toggle dark mode" />
        }
        <AuthorizeView>
            <MudText Typo="Typo.body2" Class="mx-2">@context.User.Identity?.Name</MudText>
            <MudTooltip Text="Sign out">
                @* A full page load, because signing out is a web request and not a page of the interactive app. *@
                <MudIconButton Icon="@Icons.Material.Filled.Logout" Color="Color.Inherit" aria-label="Sign out"
                               OnClick="@(() => Navigation.NavigateTo("account/logout", forceLoad: true))" />
            </MudTooltip>
        </AuthorizeView>
    </MudAppBar>
    <MudDrawer @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Elevation="2">
        <NavMenu />
    </MudDrawer>
    <MudMainContent>
        <MudContainer MaxWidth="MaxWidth.Large" Class="py-6">
            @Body
        </MudContainer>
    </MudMainContent>
</MudLayout>
}

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private const string ThemeKey = "pantrix.theme";
    private const string DarkModeKey = "pantrix.darkMode";

    private bool _drawerOpen = true;
    private AppTheme _theme = AppThemes.All[0];
    private bool _darkMode;
    private bool _themeLoaded;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            _theme = AppThemes.Find(await JS.InvokeAsync<string?>("localStorage.getItem", ThemeKey));
            _darkMode = await JS.InvokeAsync<string?>("localStorage.getItem", DarkModeKey) == "true";
        }
        catch (JSException)
        {
            // Storage can be blocked (e.g. private browsing); the app still works with the default theme.
        }

        await MarkPageWithThemeAsync();
        _themeLoaded = true;
        StateHasChanged();
    }

    private async Task SetThemeAsync(AppTheme theme)
    {
        _theme = theme;
        await MarkPageWithThemeAsync();
        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", ThemeKey, theme.Id);
        }
        catch (JSException)
        {
        }
    }

    // The theme's own CSS in app.css hangs off this attribute.
    private ValueTask MarkPageWithThemeAsync() =>
        JS.InvokeVoidAsync("document.documentElement.setAttribute", "data-theme", _theme.Id);

    private async Task ToggleDarkModeAsync()
    {
        _darkMode = !_darkMode;
        try
        {
            await JS.InvokeVoidAsync("localStorage.setItem", DarkModeKey, _darkMode ? "true" : "false");
        }
        catch (JSException)
        {
        }
    }
}
