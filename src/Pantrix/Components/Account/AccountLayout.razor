@inherits LayoutComponentBase

@* The sign-in pages are plain server-rendered HTML: signing in has to set a cookie on a normal web request,
   which the interactive part of the app can't do. So they carry their own small stylesheet. *@
<style>
    :root { --bg: #f5f5f5; --card: #fff; --text: #212121; --muted: #616161; --line: #bdbdbd; --primary: #594ae2; --on-primary: #fff; --error: #c62828;
        --font: Roboto, Helvetica, Arial, sans-serif; --heading-font: var(--font); --heading-size: 1.6rem; --radius: 8px; --card-edge: 0 2px 8px rgba(0, 0, 0, .2); }
    :root.dark { --bg: #1a1a27; --card: #32333d; --text: #ececec; --muted: #b0b0b8; --line: #5c5d6a; --primary: #8f84f0; --error: #ff8a80; }
    @* Each theme in AppThemes gets its colours repeated here, after the rules above so that it wins over .dark. *@
    :root[data-theme="arcade"] { --bg: #0a0a1f; --card: #15153a; --text: #f4f4ff; --muted: #a9add6; --line: #7d82c9; --primary: #ffd23f; --on-primary: #000; --error: #ff4d4d;
        --font: "Pixelify Sans", "Courier New", monospace; --heading-font: "Press Start 2P", var(--font); --heading-size: 1.2rem; --radius: 0; --card-edge: 0 0 0 2px #3a3af0; }
    body { margin: 0; background: var(--bg); color: var(--text); font-family: var(--font); }
    .account { max-width: 380px; margin: 12vh auto 0; padding: 32px; background: var(--card); border-radius: var(--radius); box-shadow: var(--card-edge); }
    .account .logo { display: block; margin: 0 0 16px; }
    .account h1 { margin: 0 0 4px; font-family: var(--heading-font); font-size: var(--heading-size); font-weight: 500; }
    .account p { margin: 0 0 20px; color: var(--muted); }
    .account label { display: block; margin-bottom: 16px; font-size: .85rem; color: var(--muted); }
    .account input { display: block; box-sizing: border-box; width: 100%; margin-top: 4px; padding: 10px 12px; font-family: inherit; font-size: 1rem;
        color: var(--text); background: transparent; border: 1px solid var(--line); border-radius: calc(var(--radius) / 2); }
    .account input:focus { outline: 2px solid var(--primary); outline-offset: -1px; }
    .account button { width: 100%; padding: 10px; font-family: inherit; font-size: 1rem; font-weight: 500; color: var(--on-primary); background: var(--primary);
        border: 0; border-radius: calc(var(--radius) / 2); cursor: pointer; }
    .account .error { color: var(--error); }
    .account .alternative { margin: 20px 0 0; font-size: .9rem; text-align: center; }
    .account a { color: var(--primary); }
    @@media (max-width: 480px) { .account { margin: 0; min-height: 100vh; border-radius: 0; box-sizing: border-box; } }
</style>
<script suppress-error="BL9992">
    try {
        document.documentElement.setAttribute('data-theme', localStorage.getItem('pantrix.theme') || 'classic');
        if (localStorage.getItem('pantrix.darkMode') === 'true') document.documentElement.classList.add('dark');
    } catch { }
</script>

<main class="account">
    <img class="logo" src="@Assets["icon.svg"]" alt="" width="64" height="64" />
    @Body
</main>
