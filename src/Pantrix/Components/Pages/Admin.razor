@page "/admin"
@inject CurrentUser CurrentUser
@inject AccountService Accounts
@inject StoreBrowserService Browser

<PageTitle>Admin</PageTitle>

<MudText Typo="Typo.h4" Class="mb-4">Admin</MudText>

@if (_loaded && !_isAdmin)
{
    <MudAlert Severity="Severity.Warning">Only the admin can see this page.</MudAlert>
}
else if (_loaded)
{
    <MudPaper Class="pa-4 mb-4">
        <MudSwitch T="bool" Value="_registrationOpen" ValueChanged="SetRegistrationOpenAsync" Color="Color.Primary">
            Let new people create an account
        </MudSwitch>
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            While this is on, anyone who can reach the sign-in page can sign up and gets a kitchen of their own.
            Turn it off once everyone you want has an account, especially if Pantrix is reachable from the internet.
        </MudText>
    </MudPaper>

    <MudPaper Class="pa-4 mb-4">
        <MudText Typo="Typo.h6">Browser for aisle lookups</MudText>
        <MudText Typo="Typo.body2" Class="mud-text-secondary mb-2">
            Lets Pantrix look aisles up on store websites, using the Pantrix-Browser container. Enter the address of its
            <b>control port, 9223</b>. This is not the port you open to see the browser's screen. Leave blank to switch lookups off.
        </MudText>
        <MudGrid Spacing="2" Class="align-end">
            <MudItem xs="12" sm="6">
                <MudTextField @bind-Value="_browserAddress" Label="Browser address" Placeholder="http://Pantrix-Browser:9223"
                              HelperText="With both containers on the same Docker network, use the browser container's name. A Chrome on a PC started with --remote-debugging-port uses that port instead, usually 9222." />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveBrowserAsync">Save</MudButton>
                <MudButton OnClick="TestBrowserAsync" Disabled="@string.IsNullOrWhiteSpace(_browserAddress)">Test</MudButton>
            </MudItem>
        </MudGrid>
        @if (_browserMessage is not null)
        {
            <MudAlert Severity="@(_browserOk ? Severity.Success : Severity.Warning)" Dense="true" Class="mt-2">@_browserMessage</MudAlert>
        }
    </MudPaper>

    <MudTable Breakpoint="Breakpoint.None" Items="_users" Dense="true" Hover="true">
        <HeaderContent>
            <MudTh>Account</MudTh>
            <MudTh>Working in</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd>
                @context.UserName
                @if (context.IsAdmin)
                {
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined">Admin</MudChip>
                }
            </MudTd>
            <MudTd>@context.Kitchen.Name</MudTd>
        </RowTemplate>
    </MudTable>
}

@code {
    private bool _loaded;
    private bool _isAdmin;
    private bool _registrationOpen;
    private List<AppUser> _users = [];
    private string? _browserAddress;
    private bool _browserOk;
    private string? _browserMessage;

    protected override async Task OnInitializedAsync()
    {
        _isAdmin = (await CurrentUser.GetAsync())?.IsAdmin == true;
        if (_isAdmin)
        {
            _registrationOpen = await Accounts.IsRegistrationOpenAsync();
            _users = await Accounts.GetUsersAsync();
            _browserAddress = await Browser.GetAddressAsync();
        }

        _loaded = true;
    }

    private async Task TestBrowserAsync() => (_browserOk, _browserMessage) = await Browser.TestAsync(_browserAddress);

    private async Task SaveBrowserAsync()
    {
        // Checked again here: the page may have been open since before the account stopped being an admin.
        if ((await CurrentUser.GetAsync())?.IsAdmin != true)
        {
            return;
        }

        if (string.IsNullOrWhiteSpace(_browserAddress))
        {
            await Browser.SetAddressAsync(null);
            (_browserOk, _browserMessage) = (true, "Aisle lookups are switched off.");
            return;
        }

        await TestBrowserAsync();
        if (_browserOk)
        {
            await Browser.SetAddressAsync(_browserAddress);
            _browserMessage += " Saved.";
        }
    }

    private async Task SetRegistrationOpenAsync(bool open)
    {
        // Checked again here: the page may have been open since before the account stopped being an admin.
        if ((await CurrentUser.GetAsync())?.IsAdmin != true)
        {
            return;
        }

        await Accounts.SetRegistrationOpenAsync(open);
        _registrationOpen = open;
    }
}
