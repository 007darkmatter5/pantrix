@page "/stores"
@inject IDbContextFactory<PantrixDbContext> DbFactory
@inject IDialogService DialogService
@inject StoreAisleService StoreAisles
@inject StoreBrowserService Browser

<PageTitle>Stores</PageTitle>

<MudStack Row="true" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Class="mb-4">
    <MudText Typo="Typo.h4">Stores</MudText>
    <MudSpacer />
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
               OnClick="@(() => EditAsync(null))">Add store</MudButton>
</MudStack>

<MudAlert Severity="Severity.Info" Dense="true" Class="mb-4">
    Record which aisle each item is in, here, on the ingredient, or on a shopping list while you shop.
    A shopping list with a store picked then sorts by aisle.
</MudAlert>

<MudExpansionPanels Class="mb-4">
    <MudExpansionPanel Text="How aisles are found for each of your stores">
        <MudText Typo="Typo.body2" Class="mb-2">
            Every store works with <b>manual</b> aisles. Some also work with <b>browser lookup</b>, which reads aisles from the
            store's website through a browser connected on the Admin page@(_browserConnected ? "" : " (none is connected yet)").
        </MudText>

        @if (_stores.Count == 0)
        {
            <MudText Typo="Typo.body2" Color="Color.Secondary">Add a store to see how its aisles can be found.</MudText>
        }

        @foreach (var store in _stores)
        {
            var chain = StoreCatalog.Find(store.Name);
            <MudStack @key="store.Id" Row="true" AlignItems="AlignItems.Start" Wrap="Wrap.Wrap" Spacing="2" Class="mt-3">
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                         Color="@(store.AisleSource == AisleSource.Browser ? Color.Primary : Color.Default)">@StoreCatalog.Describe(store.AisleSource)</MudChip>
                <div style="flex: 1; min-width: 220px">
                    <MudText Typo="Typo.subtitle2">@store.DisplayName</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary">@MethodReason(store, chain)</MudText>
                </div>
                @* Offered for known chains too: what Pantrix knows is a snapshot, and a site can start showing aisles. *@
                @if (store.AisleSource == AisleSource.Manual && _browserConnected)
                {
                    <MudButton Size="Size.Small" StartIcon="@Icons.Material.Filled.TravelExplore" OnClick="@(() => CheckWebsiteAsync(store))">Check website</MudButton>
                }
            </MudStack>
        }

        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-4">
            Chains Pantrix already knows:
            @string.Join(", ", StoreCatalog.Chains.Select(c => $"{c.Name} ({StoreCatalog.Describe(c.Source).ToLowerInvariant()})")).
            You can change any store's method by editing it.
        </MudText>
    </MudExpansionPanel>
</MudExpansionPanels>

@if (_stores.Count == 0)
{
    <MudText>No stores yet.</MudText>
}

<MudExpansionPanels MultiExpansion="true">
@foreach (var store in _stores)
{
    <MudExpansionPanel @key="store.Id" Expanded="@_expanded.Contains(store.Id)" ExpandedChanged="@(open => SetExpanded(store, open))">
        <TitleContent>
            <MudStack Row="true" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Spacing="2">
                <MudText Typo="Typo.h6">@store.DisplayName</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">@store.Aisles.Count @(store.Aisles.Count == 1 ? "item" : "items") located</MudText>
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                         Color="@(store.AisleSource == AisleSource.Browser ? Color.Primary : Color.Default)">@StoreCatalog.Describe(store.AisleSource)</MudChip>
                <MudSpacer />
                @* Kept from reaching the panel, so editing or deleting doesn't also open or close it. *@
                <span @onclick:stopPropagation="true">
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" OnClick="@(() => EditAsync(store))" aria-label="@($"Edit {store.DisplayName}")" />
                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" OnClick="@(() => DeleteAsync(store))" aria-label="@($"Delete {store.DisplayName}")" />
                </span>
            </MudStack>
        </TitleContent>
        <ChildContent>
        @if (store.FormattedAddress.Length > 0)
        {
            <MudText Typo="Typo.body2" Color="Color.Secondary">@store.FormattedAddress</MudText>
        }

        <MudGrid Spacing="2" Class="align-end mt-1">
            <MudItem xs="12" sm="6">
                <IngredientPicker Value="NewAisleFor(store).Ingredient" ValueChanged="@(i => NewAisleFor(store).Ingredient = i)"
                                  Ingredients="_ingredients" Label="Add an item sold here" />
            </MudItem>
            <MudItem xs="7" sm="3">
                <MudTextField @bind-Value="NewAisleFor(store).Aisle" Label="Aisle" Immediate="true" />
            </MudItem>
            <MudItem xs="5" sm="3">
                <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="@(() => AddAisleAsync(store))"
                           Disabled="@(NewAisleFor(store).Ingredient is null || string.IsNullOrWhiteSpace(NewAisleFor(store).Aisle))">Add</MudButton>
                @if (store.AisleSource == AisleSource.Browser && _browserConnected)
                {
                    <MudButton StartIcon="@Icons.Material.Filled.TravelExplore" OnClick="@(() => LookUpAsync(store))"
                               Disabled="@(NewAisleFor(store).Ingredient is null)">Look up</MudButton>
                }
                else if (store.AisleSource == AisleSource.Manual && _browserConnected)
                {
                    <MudTooltip Text="Find out whether this store's website shows aisles, so Pantrix can look them up">
                        <MudButton StartIcon="@Icons.Material.Filled.TravelExplore" OnClick="@(() => CheckWebsiteAsync(store))">Check website</MudButton>
                    </MudTooltip>
                }
            </MudItem>
        </MudGrid>

        @if (store.Aisles.Count > 0)
        {
            <MudTable Breakpoint="Breakpoint.None" Items="@store.Aisles.OrderBy(a => AisleOrder.Key(a.Aisle)).ThenBy(a => a.Ingredient.Name)" Dense="true" Elevation="0" Class="mt-2">
                <HeaderContent>
                    <MudTh>Aisle</MudTh>
                    <MudTh>Item</MudTh>
                    <MudTh Class="d-none d-sm-table-cell">Last confirmed</MudTh>
                    <MudTh></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.Aisle</MudTd>
                    <MudTd>
                        @context.Ingredient.Name
                        @if (StoreAisleService.IsWebLink(context.ProductUrl))
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.OpenInNew" Size="Size.Small" Href="@context.ProductUrl" Target="_blank"
                                           aria-label="Open product page" />
                        }
                    </MudTd>
                    <MudTd Class="d-none d-sm-table-cell">@(context.Aisle.Length > 0 ? context.LastConfirmed.ToString("MMM d, yyyy") : "")</MudTd>
                    <MudTd Style="text-align: right; white-space: nowrap">
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" OnClick="@(() => ForgetAisleAsync(context))" aria-label="Forget this aisle" />
                    </MudTd>
                </RowTemplate>
            </MudTable>
        }
        </ChildContent>
    </MudExpansionPanel>
}
</MudExpansionPanels>

@code {
    private sealed class NewAisle
    {
        public Ingredient? Ingredient { get; set; }
        public string? Aisle { get; set; }
    }

    private List<Store> _stores = [];
    private List<Ingredient> _ingredients = [];
    private bool _browserConnected;

    // Which stores are open, by id, so they stay open when the page reloads its data after a change.
    private readonly HashSet<int> _expanded = [];

    // What is being typed into each store's "add an item" row, by store id.
    private readonly Dictionary<int, NewAisle> _newAisles = [];

    protected override Task OnInitializedAsync() => LoadAsync();

    private void SetExpanded(Store store, bool open)
    {
        if (open)
        {
            _expanded.Add(store.Id);
        }
        else
        {
            _expanded.Remove(store.Id);
        }
    }

    private NewAisle NewAisleFor(Store store) =>
        _newAisles.TryGetValue(store.Id, out var entry) ? entry : _newAisles[store.Id] = new NewAisle();

    private async Task AddAisleAsync(Store store)
    {
        var entry = NewAisleFor(store);
        if (entry.Ingredient is null)
        {
            return;
        }

        await StoreAisles.SetAsync(store.Id, entry.Ingredient.Id, entry.Aisle);
        _newAisles.Remove(store.Id);
        await LoadAsync();
    }

    // Why a store has the method it has, in terms of what is known about it.
    private string MethodReason(Store store, KnownChain? chain)
    {
        if (chain is not null && chain.Source == store.AisleSource)
        {
            if (chain.Source == AisleSource.Manual)
            {
                return chain.Notes + (_browserConnected ? " That was true when Pantrix was last updated; \"Check website\" tests it again." : "");
            }

            return chain.Locations is not null && string.IsNullOrWhiteSpace(store.WebsiteStoreId)
                ? $"{chain.Notes} Its store number will be worked out from its address on the first lookup."
                : chain.Notes;
        }

        if (store.AisleSource == AisleSource.Browser)
        {
            return "Set to look aisles up using the search address you gave it.";
        }

        if (chain is not null)
        {
            return $"Set to manual by you. Pantrix can use {StoreCatalog.Describe(chain.Source).ToLowerInvariant()} for {chain.Name}; edit the store to switch back.";
        }

        return _browserConnected
            ? "Pantrix doesn't know this store, so it starts as manual. Use \"Check website\" to find out whether its site shows aisles."
            : "Pantrix doesn't know this store, so it starts as manual. Once a browser is connected on the Admin page, you can check whether its website shows aisles.";
    }

    // Tries the store's website for aisles and, if they are there, switches the store to browser lookup.
    private async Task CheckWebsiteAsync(Store store)
    {
        var parameters = new DialogParameters<StoreCheckDialog> { { d => d.Store, store } };
        var dialog = await DialogService.ShowAsync<StoreCheckDialog>(
            $"Check {store.DisplayName}", parameters, new DialogOptions { FullWidth = true, MaxWidth = MaxWidth.Small });
        if ((await dialog.Result) is { Canceled: false, Data: string searchAddress })
        {
            await using var db = await DbFactory.CreateDbContextAsync();
            await db.Stores.Where(s => s.Id == store.Id).ExecuteUpdateAsync(s => s
                .SetProperty(x => x.AisleSource, AisleSource.Browser)
                .SetProperty(x => x.SearchUrl, searchAddress));
            await LoadAsync();
        }
    }

    // Finds the item on the store's website and saves the aisle and product page of the one that's picked.
    private async Task LookUpAsync(Store store)
    {
        if (NewAisleFor(store).Ingredient is not { } ingredient)
        {
            return;
        }

        var parameters = new DialogParameters<AisleLookupDialog>
        {
            { d => d.Store, store },
            { d => d.Query, ingredient.ProductName ?? ingredient.Name }
        };
        var dialog = await DialogService.ShowAsync<AisleLookupDialog>(
            $"Find {ingredient.Name} at {store.DisplayName}", parameters, new DialogOptions { FullWidth = true, MaxWidth = MaxWidth.Small });
        if ((await dialog.Result) is { Canceled: false, Data: AisleMatch match })
        {
            await StoreAisles.SetAsync(store.Id, ingredient.Id, match.Aisle);
            await StoreAisles.SetProductUrlAsync(store.Id, ingredient.Id, match.Url);
            _newAisles.Remove(store.Id);
            await LoadAsync();
        }
    }

    private async Task LoadAsync()
    {
        _browserConnected = await Browser.GetAddressAsync() is not null;
        await using var db = await DbFactory.CreateDbContextAsync();
        _ingredients = await db.Ingredients.AsNoTracking().OrderBy(i => i.Name).ToListAsync();
        _stores = await db.Stores.AsNoTracking()
            .Include(s => s.Aisles).ThenInclude(a => a.Ingredient)
            .OrderBy(s => s.Name).ThenBy(s => s.Location)
            .ToListAsync();
    }

    private async Task EditAsync(Store? store)
    {
        var parameters = new DialogParameters<StoreDialog> { { d => d.Store, store } };
        var dialog = await DialogService.ShowAsync<StoreDialog>(store is null ? "Add store" : "Edit store", parameters);
        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            await LoadAsync();
        }
    }

    private async Task DeleteAsync(Store store)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Delete store", $"Delete \"{store.DisplayName}\" and the aisles recorded for it?",
            yesText: "Delete", cancelText: "Cancel");
        if (confirmed != true)
        {
            return;
        }

        await using var db = await DbFactory.CreateDbContextAsync();
        await db.Stores.Where(s => s.Id == store.Id).ExecuteDeleteAsync();
        await LoadAsync();
    }

    private async Task ForgetAisleAsync(StoreAisle aisle)
    {
        await using var db = await DbFactory.CreateDbContextAsync();
        await db.StoreAisles.Where(a => a.Id == aisle.Id).ExecuteDeleteAsync();
        await LoadAsync();
    }
}
